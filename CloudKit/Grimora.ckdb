DEFINE SCHEMA

    RECORD TYPE DeviceSnapshot (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        capturedAt      TIMESTAMP QUERYABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraCardList (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        entityID        STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        sourceDeviceID  STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraCardListCategory (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        entityID        STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        sourceDeviceID  STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraCardListEntry (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        entityID        STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        sourceDeviceID  STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraRecoveryRevision (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        capturedAt      TIMESTAMP QUERYABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraSyncMetadata (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        entityID        STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        sourceDeviceID  STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GrimoraUserPreferences (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        deletedAt       TIMESTAMP QUERYABLE SORTABLE,
        entityID        STRING QUERYABLE SEARCHABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        sourceDeviceID  STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LibraryIdentity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        capturedAt      TIMESTAMP QUERYABLE SORTABLE,
        payload         ENCRYPTED BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
