{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteCatalogObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::grimora-catalog-artifacts-bjpqvzr5pz/*",
        "arn:aws:s3:::grimora-catalog-metadata-bjpqvzr5pz/*"
      ]
    },
    {
      "Sid": "ListCatalogMultipartUploads",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::grimora-catalog-artifacts-bjpqvzr5pz",
        "arn:aws:s3:::grimora-catalog-metadata-bjpqvzr5pz"
      ]
    }
  ]
}
